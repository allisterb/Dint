<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
    
    <PackageReference Include="OpenCvSharp4" Version="4.10.0.20240616" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.10.0.20240616" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Dint.Bindings\Dint.Bindings.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <Target Name="CopyDefs" AfterTargets="Build">
    <Copy SourceFiles="$(SolutionDir)\Dint.Vision.Native\bin\x64\Debug\dint.dll" DestinationFolder="$(OutDir)" />
    <Copy SourceFiles="$(SolutionDir)\..\lib\opencv\x64\vc16\bin\opencv_world4100d.dll" DestinationFolder="$(OutDir)" Condition="Exists('$(SolutionDir)\..\lib\opencv\x64\vc16\bin\opencv_world4100d.dll')" />
  </Target>
</Project>
